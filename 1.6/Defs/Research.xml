<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ResearchTabDef>
    <defName>MA_Tab</defName>
    <label>Mounted Arms</label>
    <generalTitle>Mounted weapons</generalTitle>
    <generalDescription>Research mounted weapon systems adapted from modern military hardware. Turrets unlocked here appear in the Security build menu.</generalDescription>
  </ResearchTabDef>

  <ResearchProjectDef>
    <defName>MA_Research_GPMG</defName>
    <label>general-purpose machine guns</label>
    <description>Belt-fed machine guns on automated mounts. Unlocks the M240 turret.</description>
    <baseCost>900</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>MA_Tab</tab>
    <prerequisites>
      <li>GunTurrets</li>
    </prerequisites>
    <hideWhen>
      <turretsDisabled>true</turretsDisabled>
    </hideWhen>
    <researchViewX>0.00</researchViewX>
    <researchViewY>0.50</researchViewY>
  </ResearchProjectDef>

  <!-- Earliest mount: no power and no turret research, only gunsmithing -->
  <ResearchProjectDef>
    <defName>MA_Research_Gatling</defName>
    <label>hand-cranked machine guns</label>
    <description>Multi-barrel guns turned by a hand crank, mounted on a wheeled field carriage. Unlocks the Gatling gun.</description>
    <baseCost>600</baseCost>
    <techLevel>Industrial</techLevel>
    <tab>MA_Tab</tab>
    <prerequisites>
      <li>Gunsmithing</li>
    </prerequisites>
    <hideWhen>
      <turretsDisabled>true</turretsDisabled>
    </hideWhen>
    <researchViewX>0.00</researchViewX>
    <researchViewY>1.25</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>MA_Research_HMG</defName>
    <label>heavy machine guns</label>
