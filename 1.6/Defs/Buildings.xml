<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--=============== Bases ===============-->

  <ThingDef Name="MA_TurretBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <statBases>
      <Flammability>0.7</Flammability>
      <Beauty>-20</Beauty>
    </statBases>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
  </ThingDef>

  <!-- Automatic: needs power, can be switched off, barrel refurbished with steel -->
  <ThingDef Name="MA_AutoTurretBase" ParentName="MA_TurretBase" Abstract="True">
    <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
  </ThingDef>

  <!-- Manned: no power, a colonist must operate it (like the mortar) -->
  <ThingDef Name="MA_MannedTurretBase" ParentName="MA_TurretBase" Abstract="True">
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
        <planetLayerWhitelist>
          <li>Surface</li>
        </planetLayerWhitelist>
      </li>
    </comps>
  </ThingDef>

  <!--=============== M240 (automatic) ===============-->

  <ThingDef ParentName="MA_AutoTurretBase">
    <defName>MA_Turret_M240_MG</defName>
    <label>M240 turret</label>
    <description>An automated mount for a belt-fed general-purpose machine gun. Long bursts of rifle-caliber rounds make it a good all-round defense. Its barrel must be refurbished with steel after use. May explode when damaged.</description>
    <graphicData>
      <texPath>MountedArms/M240_Base</texPath>
    </graphicData>
    <uiIconPath>MountedArms/M240_Icon</uiIconPath>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>40</Mass>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <costList>
      <Steel>220</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="MountedArms.CompProperties_BarrelHeat">
        <heatPerShot>0.0318</heatPerShot>
        <coolPerSecond>0.02</coolPerSecond>
        <resumeAt>0.5</resumeAt>
        <smokeAt>0.7</smokeAt>
        <heatSpread>2.0</heatSpread>
        <burstSpread>0.05</burstSpread>
      </li>
      <li Class="MountedArms.CompProperties_TurretSlew">
        <degreesPerSecond>55</degreesPerSecond>
        <aimTolerance>4</aimTolerance>
        <arcDegrees>0</arcDegrees>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shots until barrel change</fuelLabel>
        <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
        <outOfFuelMessage>Needs new barrel</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
        <fuelCapacity>150</fuelCapacity>      <!-- 30 bursts of 5 -->
        <fuelMultiplier>2</fuelMultiplier>    <!-- 75 steel per full rearm -->
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
    </comps>
    <building>
      <turretGunDef>MA_Gun_M240_MG</turretGunDef>
      <turretBurstWarmupTime>0.6</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.4</turretBurstCooldownTime>
      <turretTopDrawSize>2.12</turretTopDrawSize>
    </building>
    <modExtensions>
      <li Class="MountedArms.MuzzleExtension">
        <distance>0.6</distance>
        <flashScale>9</flashScale>
      </li>
    </modExtensions>
    <researchPrerequisites>
      <li>MA_Research_GPMG</li>
    </researchPrerequisites>
  </ThingDef>

