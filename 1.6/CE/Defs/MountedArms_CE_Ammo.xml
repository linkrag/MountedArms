<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ================================================================= -->
	<!--  Guided rocket battery (CE): indirect-fire variant of the 70 mm   -->
	<!--  APKWS. CE's Bullet_70mmAPKWS_HEAT has speed 173 and gravity 1;   -->
	<!--  ProjectileCE.Launch flies at Max(chargeSpeed, def speed), so the -->
	<!--  rocket ignored the charge (aimed for ~50, flew at 173) and       -->
	<!--  overshot off the map. Like the 81 mm shell: speed 0 (charge      -->
	<!--  decides) and gravityFactor 5 (charges 30/50/70/90 assume it).    -->
	<!--  Same ammo item, own projectile. Warhead as HE: bigger blast (3.5) and fewer -->
	<!--  fragments than the 81 mm HE, so it reads as a blast, not frag.  -->
	<!-- ================================================================= -->

	<CombatExtended.AmmoSetDef>
		<defName>MA_AmmoSet_APKWS_Indirect</defName>
		<label>70mm APKWS Rockets (indirect)</label>
		<ammoTypes>
			<Ammo_70mmAPKWS_HEAT>MA_Bullet_APKWS_Indirect_HE</Ammo_70mmAPKWS_HEAT>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<ThingDef ParentName="Base70mmAPKWS">
		<defName>MA_Bullet_APKWS_Indirect_HE</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>APKWS rocket (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket/70mmAPKWS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bomb</damageDef>
			<damageAmountBase>156</damageAmountBase>
			<explosionRadius>3.5</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
			<speed>0</speed>
			<gravityFactor>5</gravityFactor>
		</projectile>
		<!-- Inherit False drops the parent's CE ProjectileFleck (flame placed by speed: it sat mid-rocket);
		     MountedArms.CompProperties_Exhaust (MountedArmsFx.dll) puts it at the nozzle -->
		<comps Inherit="False">
			<li Class="MountedArms.CompProperties_Exhaust">
				<flameFleck>Fleck_CERocketFlame</flameFleck>
				<smokeFleck>Fleck_CERocketSmokeTrail</smokeFleck>
				<nozzleDistance>0.45</nozzleDistance>
				<flameScale>1</flameScale>
				<smokeScale>1.5</smokeScale>
			</li>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>6</Fragment_Large>
					<Fragment_Small>10</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>


	<!-- ================================================================= -->
	<!--  Stinger (FIM-92) for the Avenger: CE has no MANPADS ammo.        -->
	<!--  Fired only by the CIWS-skyfaller verb (drop pods).               -->
	<!-- ================================================================= -->

	<CombatExtended.AmmoCategoryDef>
		<defName>MA_FIM92</defName>
		<label>Stinger missile</label>
		<labelShort>Stinger</labelShort>
		<description>Infrared-homing surface-to-air missile.</description>
	</CombatExtended.AmmoCategoryDef>

	<CombatExtended.AmmoSetDef>
		<defName>MA_AmmoSet_FIM92</defName>
		<label>Stinger missiles</label>
		<ammoTypes>
			<MA_Ammo_FIM92_Stinger>MA_Bullet_FIM92_Stinger</MA_Ammo_FIM92_Stinger>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="HeavyAmmoBase">
		<defName>MA_Ammo_FIM92_Stinger</defName>
		<label>Stinger missile</label>
		<description>An infrared-homing surface-to-air missile in its launch tube, for the Avenger missile turret.</description>
		<graphicData>
			<texPath>MountedArms/Stinger_Item</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>15</Mass>
			<Bulk>30</Bulk>
			<MarketValue>350</MarketValue>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableCrafting_TableMachining</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoMissiles</li>
		</thingCategories>
		<stackLimit>16</stackLimit>
		<ammoClass>MA_FIM92</ammoClass>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>MA_Bullet_FIM92_Stinger</defName>
		<label>Stinger missile</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket_Big</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>0.8</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>80</damageAmountBase>
			<armorPenetrationSharp>20</armorPenetrationSharp>
			<armorPenetrationBlunt>120</armorPenetrationBlunt>
			<speed>150</speed>
			<impactChance>0.8</impactChance>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>

	<!-- CE ammo injector looks the recipe up as "Make" + ammo defName -->
	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeMA_Ammo_FIM92_Stinger</defName>
		<label>make Stinger missiles x4</label>
		<description>Assemble four Stinger missiles.</description>
		<jobString>Assembling Stinger missiles.</jobString>
		<researchPrerequisite>MA_Research_Stinger</researchPrerequisite>
		<workAmount>12000</workAmount>
		<skillRequirements>
			<Crafting>7</Crafting>
		</skillRequirements>
		<ingredients>
			<li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
			<li><filter><thingDefs><li>FSX</li></thingDefs></filter><count>8</count></li>
			<li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>2</count></li>
		</ingredients>
		<fixedIngredientFilter><thingDefs><li>Steel</li><li>FSX</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
		<products><MA_Ammo_FIM92_Stinger>4</MA_Ammo_FIM92_Stinger></products>
	</RecipeDef>

	<!-- Laser pulse for the laser CIWS: a very fast CE projectile with the charge-lance graphic.
	     The gun has no AmmoUser, so it never needs ammunition. -->
	<ThingDef ParentName="BaseBulletCE">
		<defName>MA_Bullet_LaserPulse</defName>
		<label>laser pulse</label>
		<graphicData>
			<texPath>Things/Projectile/ChargeLanceShot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>30</damageAmountBase>
			<armorPenetrationSharp>18</armorPenetrationSharp>
			<armorPenetrationBlunt>40</armorPenetrationBlunt>
			<speed>400</speed>
			<dropsCasings>false</dropsCasings>
		</projectile>
	</ThingDef>

</Defs>
